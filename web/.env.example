# Copy to .env.local (ignored by git) and fill in. Without any provider the app runs in structured mode.
# Names only: no values here.

# Primary provider (OpenRouter, OpenAI-compatible). Comma-separated model ids; the first is the default.
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

# Fallback provider (NVIDIA NIM, OpenAI-compatible). Also runs the content-safety check on user input.
PYRION_LLM_BASE_URL=
PYRION_LLM_API_KEY=
PYRION_LLM_MODELS=

# Budget protection (optional)
PYRION_DAILY_REQUEST_CAP=
PYRION_VISITOR_LIMIT_PER_HOUR=
PYRION_VISITOR_PRIMARY_PER_HOUR=
# Only a proxy we run may tell us the visitor's address: set to 1 behind nginx that sets x-real-ip.
PYRION_TRUST_PROXY=
# Models a visitor may choose (default: the two cheap ones). Others stay server-side.
PYRION_CLIENT_MODELS=
# Models whose license has been checked and may be labelled "open weights" on the page. Default: none.
PYRION_OPEN_WEIGHTS_MODELS=
